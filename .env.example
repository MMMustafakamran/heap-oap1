# Names only. Copy the values into the files named below; never commit them.

# backend/.env (read by `uv run --env-file .env uvicorn ...`; the OpenAI Agents SDK reads it)
OPENAI_API_KEY=

# frontend/.env.local (the doc's own override for the agent URL; harness port, never 8000)
AGENT_URL=http://localhost:8091/agent
